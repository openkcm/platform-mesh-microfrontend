FROM node:22-alpine AS build
WORKDIR /app
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --ignore-scripts
COPY ui/tsconfig.json ui/vite.config.ts ui/index.html ./
COPY ui/src ./src
RUN npm run build

FROM nginx:1.29-alpine
LABEL org.opencontainers.image.source=https://github.com/openkcm/platform-mesh-microfrontend
LABEL org.opencontainers.image.title=platform-mesh-microfrontend
COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY ui/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
